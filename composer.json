{
    "name": "cubotecnologia/laravel-jwt-identity-guard",
    "description": "JWT Identity + Type Authorization middleware for Laravel microservices",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "tymon/jwt-auth": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cubotecnologia\\JwtIdentityGuard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "app\\JwtIdentityGuard\\JwtIdentityServiceProvider"
            ]
        }
    }
}
